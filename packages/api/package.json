{
  "name": "@cgw/api",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "The client for the Workspace API, typed from the server's checked-in OpenAPI document (server/openapi/v1.json). No React, no DOM beyond fetch.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "node ../../scripts/api-generate.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
