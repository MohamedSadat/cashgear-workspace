    "@cgw/doc": "workspace:*",
    "@tiptap/core": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
