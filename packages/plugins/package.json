    "./view": "./src/view.tsx",
    "./i18n": "./src/i18n/catalogues.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cashgear/ui": "github:MohamedSadat/CashGear.React.UI#ef1277e78c6151643043fe3327a7f0733307b873",
    "@cgw/database": "workspace:*",
    "@cgw/workspace": "workspace:*",
    "i18next": "27.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/jsdom": "30.0.0",
    "jsdom": "31.0.0"
  }
