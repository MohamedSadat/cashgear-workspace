{
  "name": "cashgear-workspace",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "dev:web": "pnpm --filter @cgw/web dev",
    "dev:desktop": "pnpm --filter @cgw/desktop dev",
    "dev:server": "node scripts/server-stack.mjs",
    "build": "pnpm --filter @cgw/web build && node scripts/third-party-notices.mjs",
    "preview": "pnpm --filter @cgw/web preview",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test -c playwright.desktop.config.ts",
    "rust:fmt": "cargo fmt --all --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "deny": "cargo deny check licenses sources",
    "licenses:check": "node scripts/check-licenses.mjs",
    "licenses:selftest": "node scripts/license-selftest.mjs",
    "licenses:nuget": "node scripts/check-nuget-licenses.mjs",
    "secrets:check": "node scripts/check-secrets.mjs && node scripts/check-secrets.mjs --selftest",
    "notices": "node scripts/third-party-notices.mjs",
    "server:build": "dotnet build server/Cgw.Server.slnx -nologo -v q",
    "server:test": "dotnet test --solution server/Cgw.Server.slnx",
    "api:generate": "node scripts/api-generate.mjs",
    "api:check": "node scripts/api-generate.mjs --check",
    "desktop:build": "pnpm build && pnpm --filter @cgw/desktop build",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:installer": "node scripts/desktop-installer.mjs",
    "desktop:installer-test": "node scripts/installer-test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "bench:s3": "node bench/ydoc-check.mjs",
    "bench:browser": "pnpm --filter @cgw/bench-editor build && node bench/editor/run-browser.mjs",
    "bench:phase1": "pnpm --filter @cgw/bench-editor build && node bench/phase1.mjs",
    "bench:phase2": "node bench/phase2.mjs",
    "bench:phase3": "node bench/phase3.mjs",
    "bench:phase4": "node bench/phase4.mjs",
    "bench:webview2-host": "cargo build -p cgw-webview2-host --release",
    "bench:sequence": "dotnet run -c Release --project bench/sequence-dotnet/S8Harness.csproj -- \"Server=(localdb)\\MSSQLLocalDB;Integrated Security=true;TrustServerCertificate=true\" bench/results/s8-sequence.json",
    "bench:sheet-embed": "node bench/sheet-embed/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "azurite": "3.37.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
