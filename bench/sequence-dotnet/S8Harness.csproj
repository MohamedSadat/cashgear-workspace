<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike S8: sequence assignment under a page-row lock, 50 concurrent writers, SQL Server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SqlClient needs culture data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- 9.0.18, which the client brings, has known advisories; this is the patched .NET 10 line. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
